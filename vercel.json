{
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "offstumpwebsite.vercel.app"
        }
      ],
      "destination": "https://www.offstump.site/$1",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/crm/dashboard",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin/analytics",
      "destination": "/admin/analytics.html"
    },
    {
      "source": "/admin/users",
      "destination": "/admin/users.html"
    },
    {
      "source": "/auth/login",
      "destination": "/auth/login.html"
    },
    {
      "source": "/auth/unauthorized",
      "destination": "/auth/unauthorized.html"
    },
    {
      "source": "/premium",
      "destination": "/premium.html"
    },
    {
      "source": "/indoor-cricket-guwahati",
      "destination": "/indoor-cricket-guwahati.html"
    },
    {
      "source": "/cricket-nets-guwahati",
      "destination": "/cricket-nets-guwahati.html"
    },
    {
      "source": "/bowling-machine-practice-guwahati",
      "destination": "/bowling-machine-practice-guwahati.html"
    },
    {
      "source": "/automatic-cricket-practice-guwahati",
      "destination": "/automatic-cricket-practice-guwahati.html"
    },
    {
      "source": "/cricket-practice-guwahati",
      "destination": "/cricket-practice-guwahati.html"
    },
    {
      "source": "/batting-practice-guwahati",
      "destination": "/batting-practice-guwahati.html"
    },
    {
      "source": "/cricket-training-guwahati",
      "destination": "/cricket-training-guwahati.html"
    },
    {
      "source": "/cricket-nets-near-me",
      "destination": "/cricket-nets-near-me.html"
    },
    {
      "source": "/cricket-practice-near-me",
      "destination": "/cricket-practice-near-me.html"
    },
    {
      "source": "/cricket-bowling-machine-guwahati",
      "destination": "/cricket-bowling-machine-guwahati.html"
    },
    {
      "source": "/cricket-turf-guwahati",
      "destination": "/cricket-turf-guwahati.html"
    },
    {
      "source": "/turf-near-me-guwahati",
      "destination": "/turf-near-me-guwahati.html"
    },
    {
      "source": "/best-turf-guwahati",
      "destination": "/best-turf-guwahati.html"
    },
    {
      "source": "/cricket-turf-booking-guwahati",
      "destination": "/cricket-turf-booking-guwahati.html"
    },
    {
      "source": "/sports-turf-guwahati",
      "destination": "/sports-turf-guwahati.html"
    },
    {
      "source": "/cricket-ground-guwahati",
      "destination": "/cricket-ground-guwahati.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}